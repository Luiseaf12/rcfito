{
  "name": "rcfito",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build --outDir dist/client && node scripts/build-site-worker.mjs",
    "preview": "npm run build:frontend && vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "test": "tsx --test test/domain.test.ts test/catalogs.test.ts test/group-selection.test.ts test/connection.test.ts test/site-worker.test.mjs test/tunnel-publisher.test.mjs test/applications.test.ts test/application-import.test.ts test/application-ai.test.mjs test/ai-settings.test.mjs test/ai-settings-client.test.ts",
    "standards:check": "node .project-standards/check.mjs",
    "docs:check": "npm run standards:check",
    "build:frontend": "tsc -b && vite build"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "lucide-react": "1.66.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
